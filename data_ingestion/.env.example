# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG TÙY CHỌN CHO DATA INGESTION (SAO CHÉP THÀNH .env KHI CẦN)
# Lệnh tạo file .env từ mẫu:
#   Copy-Item data_ingestion\.env.example data_ingestion\.env
# ==============================================================================

# 1. Chọn nguồn dự phòng vnstock 6.0 OpenAPI khi có API Key CTCK (để trống nếu chưa dùng)
# Giá trị hỗ trợ nến 1m: dnse | ssi | tcbs
VNSTOCK_SOURCE=

# Khóa tài khoản Vnstock (tùy chọn, lấy tại https://vnstocks.com/account#api-key)
VNSTOCK_API_KEY=

# 2. API Key theo từng Công ty Chứng khoán (chỉ cần điền của CTCK bạn chọn ở VNSTOCK_SOURCE)
# --- DNSE (Entrade) ---
DNSE_API_KEY=
DNSE_API_SECRET=

# --- SSI (FastConnect) ---
SSI_API_KEY=
SSI_API_SECRET=

# --- TCBS ---
TCBS_API_KEY=

# --- FHSC (Lưu ý: chỉ hỗ trợ 5m, 15m, 30m, 1D — không có nến 1m) ---
FHSC_API_KEY=

# 3. Chu kỳ lưu gộp Bronze Store xuống Parquet (mặc định 3600 giây = 1 giờ)
BRONZE_FLUSH_INTERVAL_SECONDS=3600
