{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One row of a published baseline export (Parquet at <export_path>), BRD appendix A3",
  "description": "Grain: baseline_version x symbol x session_id x time_bucket x metric x window_size. Only READY and ZERO_STD rows are usable; SPARSE means NO_BASELINE for that cohort. std is the sample std (ddof=1).",
  "type": "object",
  "required": ["baseline_version", "valid_for_trading_date", "train_start", "train_end", "symbol", "exchange",
               "session_id", "time_bucket", "metric", "window_size", "sample_count", "mean", "std", "p95", "p99",
               "baseline_status"],
  "properties": {
    "baseline_version": {"type": "string"},
    "baseline_date": {"type": "string", "format": "date"},
    "valid_for_trading_date": {"type": "string", "format": "date"},
    "train_start": {"type": "string", "format": "date"},
    "train_end": {"type": "string", "format": "date"},
    "symbol": {"type": "string"},
    "exchange": {"type": "string"},
    "session_id": {"enum": ["morning", "afternoon"]},
    "time_bucket": {"type": "string", "pattern": "^\\d{2}:\\d{2}$", "description": "Asia/Ho_Chi_Minh local start of the 5m bucket"},
    "metric": {"enum": ["return_simple", "volume_sum", "news_count"]},
    "window_size": {"enum": ["5m", "30m", "1h"], "description": "return_simple and volume_sum: 5m only; news_count: 5m, 30m and 1h (all configured news windows are exported); B6 scores news with news_count/30m"},
    "sample_count": {"type": "integer", "minimum": 1},
    "mean": {"type": ["number", "null"]},
    "std": {"type": ["number", "null"]},
    "median": {"type": ["number", "null"]},
    "p95": {"type": ["number", "null"]},
    "p99": {"type": ["number", "null"]},
    "baseline_status": {"enum": ["READY", "ZERO_STD", "SPARSE"]},
    "fallback_level": {"type": "string"},
    "formula_version": {"type": "string"},
    "source_snapshot": {"type": "string"},
    "run_id": {"type": "string"},
    "config_hash": {"type": "string"}
  },
  "additionalProperties": false
}
